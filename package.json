{
  "name": "SavePinned",
  "version": "1.1.2",
  "description": "A chrome extension to save and load groups of pinned tabs",
  "scripts": {
    "clean": "rimraf dist/",
    "build:schema": "ajv compile -s schema/sets.json -o src/scripts/validate_sets_schema.min.js",
    "build:app": "parcel build src/manifest.json --config @parcel/config-webextension",
    "build:clean": "npm run clean && npm run build:app",
    "build": "npm run build:schema && npm run build:clean",
    "watch": "parcel watch src/manifest.json --config @parcel/config-webextension"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brainz80/SavePinned.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/brainz80/SavePinned/issues"
  },
  "homepage": "https://github.com/brainz80/SavePinned#readme",
  "devDependencies": {
    "@parcel/config-webextension": "^2.8.3",
    "@parcel/transformer-sass": "^2.8.3",
    "ajv-cli": "^5.0.0",
    "parcel": "^2.8.3",
    "rimraf": "^5.0.0",
    "sass": "^1.58.1"
  },
  "dependencies": {
    "file-saver": "^2.0.5",
    "sweetalert": "^2.1.2",
    "webextension-polyfill": "^0.12.0"
  }
}
